# Copy this file to .env and fill in real values. NEVER commit .env itself.

# Public site URL (no trailing slash). TODO: replace after buying the domain.
SITE_URL="https://nexlanedigital.vercel.app"

# WhatsApp business number (international format, digits only, NO + / spaces).
# FAKE example below — replace with the real business number, or leave EMPTY
# to hide every WhatsApp button/link (contact page shows form + email + socials).
# Personal phone numbers must only ever live here, never in source code.
NEXT_PUBLIC_WHATSAPP_NUMBER="910000000000"

# Optional: Google Search Console verification token (meets via <meta name="google-site-verification">)
GOOGLE_SITE_VERIFICATION=""

# Indexing switch (AGENTS §12.5): site stays NOINDEX until the real domain exists.
# Owner flips this to "true" at launch (then rebuild). Anything but "true" = robots
# disallow all + <meta name="robots" content="noindex, nofollow"> on every page.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# Analytics: "off" | "vercel" (Vercel Analytics, privacy friendly). Read in src/config/site.ts
NEXT_PUBLIC_ANALYTICS="off"

# Form delivery (server-side only). Optional: free tier exists at resend.com.
# Without a key the server route still validates + logs submissions server-side.
RESEND_API_KEY=""
# Id must be verified in your Resend account. TODO: add a real mailbox + domain.
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_TO_EMAIL=""

# Optional bot protection (off by default). Get keys at dash.cloudflare.com (turnstile is free).
TURNSTILE_ENABLED=""
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ===== Phase 2A: New Admin Authentication =====
# Supabase configuration (create a NEW Supabase project for Nexlane Digital)
# Get these from your Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Admin allowlist emails (exactly two) — NEVER commit real emails.
# The owner sets these in Vercel/local env directly.
# Your code reads these env vars, never hardcoded emails.
ADMIN_EMAIL_1=""
ADMIN_EMAIL_2=""

# Admin route slug — one random, unguessable path segment; do not include a slash.
# Production admin routes return 404 if this is unset (e.g. "panel-x7f9k2").
# Development: if unset, defaults to "panel-x7f" (dev-only fallback).
# Old /admin paths will 404 in production.
ADMIN_ROUTE_SLUG=""
